# ==============================================================================
# VideoIntegrity — Comprehensive .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# Runtime Application Data (captured frames, SQLite DBs, tamper snapshots)
# ------------------------------------------------------------------------------
backend/data/*
!backend/data/.gitkeep
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Sample/temporary media files generated during local testing
*.mp4
*.avi
*.mkv
*.mov
*.webm

# ------------------------------------------------------------------------------
# Python / FastAPI / Pytest
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
pip-wheel-metadata/
MANIFEST

# Virtual environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Testing & linting caches
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/
.hypothesis/
coverage.xml
*.cover

# ------------------------------------------------------------------------------
# Frontend (Node.js / Vite / React)
# ------------------------------------------------------------------------------
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/build/
.vite/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.eslintcache
.parcel-cache/
.tsbuildinfo

# ------------------------------------------------------------------------------
# Environment Variables & Secrets
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example

# ------------------------------------------------------------------------------
# Logs & Temp Files
# ------------------------------------------------------------------------------
logs/
*.log
*.tmp
*.temp
*.bak
*.swp
*.swo
*~

# ------------------------------------------------------------------------------
# IDEs & Editors
# ------------------------------------------------------------------------------
.vscode/
!.vscode/extensions.json
.idea/
*.iml
*.ipr
*.iws
*.sublime-project
*.sublime-workspace

# ------------------------------------------------------------------------------
# Operating System Artifacts
# ------------------------------------------------------------------------------
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Linux
.directory
.Trash-*
